# Copy to .env and fill in. Never commit .env.

# paper (default) | live. Live also requires a bucket with live: true AND a real
# execution adapter for that bucket. No live adapters exist yet.
TRADING_MODE=paper

# Base RPC. Bucket 1's price feed and history backfill need this.
# Alchemy: https://dashboard.alchemy.com → create an app on Base Mainnet → copy the API key.
ALCHEMY_API_KEY=
# Or point at any other Base provider instead (these override the Alchemy key):
# BASE_RPC_URL=https://...
# BASE_WS_URL=wss://...

# Telegram control plane (optional — alerts are disabled if missing)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides
# DB_PATH=./data/capital.db
# LOG_LEVEL=info
